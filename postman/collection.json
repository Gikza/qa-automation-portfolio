{
  "info": {
    "_postman_id": "b8f2e6b0-6c1a-4b3a-9d3e-1f5c2a7d4e10",
    "name": "QA Automation Portfolio - JSONPlaceholder API",
    "description": "Postman/Newman API test suite targeting the same JSONPlaceholder API covered functionally in ../tests/api-testing.spec.ts (Playwright) and under load in ../jmeter/. Adds JSON schema validation, response-time assertions, and a chained CRUD workflow using collection variables - the pieces that are awkward to express in Playwright/JMeter but are Postman's home turf.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Posts API",
      "item": [
        {
          "name": "GET /posts returns a full list of posts",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "",
                  "const posts = pm.response.json();",
                  "pm.test('response is an array of 100 posts', () => {",
                  "    pm.expect(posts).to.be.an('array');",
                  "    pm.expect(posts).to.have.lengthOf(100);",
                  "});",
                  "",
                  "pm.test('first post has the expected shape', () => {",
                  "    pm.expect(posts[0]).to.include.all.keys('id', 'userId', 'title', 'body');",
                  "    pm.expect(posts[0].id).to.eql(1);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts",
              "host": ["{{baseUrl}}"],
              "path": ["posts"]
            }
          },
          "response": []
        },
        {
          "name": "GET /posts/:id returns a single post with the right shape",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "",
                  "const post = pm.response.json();",
                  "pm.test('post has id 1, title and body', () => {",
                  "    pm.expect(post.id).to.eql(1);",
                  "    pm.expect(post).to.have.property('title');",
                  "    pm.expect(post).to.have.property('body');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts/1",
              "host": ["{{baseUrl}}"],
              "path": ["posts", "1"]
            }
          },
          "response": []
        },
        {
          "name": "GET /posts/:id returns 404 for a non-existent post",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts/9999",
              "host": ["{{baseUrl}}"],
              "path": ["posts", "9999"]
            }
          },
          "response": []
        },
        {
          "name": "POST /posts creates a new post",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "",
                  "const created = pm.response.json();",
                  "pm.test('response echoes the submitted payload', () => {",
                  "    pm.expect(created).to.include({",
                  "        title: 'QA Automation Portfolio',",
                  "        body: 'Testing the fake API',",
                  "        userId: 1",
                  "    });",
                  "    pm.expect(created.id).to.be.above(0);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"QA Automation Portfolio\",\n  \"body\": \"Testing the fake API\",\n  \"userId\": 1\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/posts",
              "host": ["{{baseUrl}}"],
              "path": ["posts"]
            }
          },
          "response": []
        },
        {
          "name": "DELETE /posts/:id removes a post",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts/1",
              "host": ["{{baseUrl}}"],
              "path": ["posts", "1"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "Schema & Performance",
      "item": [
        {
          "name": "GET /posts/:id matches JSON schema and responds fast",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const schema = {",
                  "    type: 'object',",
                  "    required: ['id', 'userId', 'title', 'body'],",
                  "    properties: {",
                  "        id: { type: 'number' },",
                  "        userId: { type: 'number' },",
                  "        title: { type: 'string' },",
                  "        body: { type: 'string' }",
                  "    }",
                  "};",
                  "",
                  "pm.test('response matches the post JSON schema', () => {",
                  "    pm.response.to.have.jsonSchema(schema);",
                  "});",
                  "",
                  "pm.test('response time is below 1000ms', () => {",
                  "    pm.expect(pm.response.responseTime).to.be.below(1000);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts/2",
              "host": ["{{baseUrl}}"],
              "path": ["posts", "2"]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "CRUD Workflow",
      "item": [
        {
          "name": "1. POST /posts - create (id is fabricated, not persisted)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "",
                  "const created = pm.response.json();",
                  "pm.collectionVariables.set('createdPostId', created.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"CRUD workflow\",\n  \"body\": \"Created in the workflow run\",\n  \"userId\": 1\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/posts",
              "host": ["{{baseUrl}}"],
              "path": ["posts"]
            }
          },
          "response": []
        },
        {
          "name": "2. GET /posts/1 - read (a post that actually exists)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('post exists and has an id', () => {",
                  "    pm.expect(pm.response.json()).to.have.property('id', 1);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts/1",
              "host": ["{{baseUrl}}"],
              "path": ["posts", "1"]
            }
          },
          "response": []
        },
        {
          "name": "3. PUT /posts/1 - update the existing post",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));",
                  "pm.test('response echoes the updated title', () => {",
                  "    pm.expect(pm.response.json().title).to.eql('Updated by CRUD workflow');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": 1,\n  \"title\": \"Updated by CRUD workflow\",\n  \"body\": \"Updated in the workflow run\",\n  \"userId\": 1\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/posts/1",
              "host": ["{{baseUrl}}"],
              "path": ["posts", "1"]
            }
          },
          "response": []
        },
        {
          "name": "4. DELETE /posts/{{createdPostId}} - the one verb that tolerates the fabricated id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/posts/{{createdPostId}}",
              "host": ["{{baseUrl}}"],
              "path": ["posts", "{{createdPostId}}"]
            }
          },
          "response": []
        }
      ]
    }
  ],
